---
import "../styles/global.css";
import { url } from "../lib/posts";

interface Props {
  title?: string;
  description?: string;
  current?: "articles" | "aboutme";
}

const { title, description = "mu7suki's blog.", current } = Astro.props;
const pageTitle = title ? `${title} — Blog` : "Blog";
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&family=IBM+Plex+Sans+JP:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <header class="site-header">
    <a class="site-title" href={url("home/")}>Blog</a>
    <nav class="site-nav">
      <a href={url("articles/")} aria-current={current === "articles" ? "page" : undefined}>all articles</a>
      <span class="sep">·</span>
      <a href={url("aboutme/")} aria-current={current === "aboutme" ? "page" : undefined}>about me</a>
    </nav>
  </header>

  <main class="site-main">
    <slot />
  </main>

  <footer class="site-footer">© 2026 mu7suki</footer>
</body>
</html>
