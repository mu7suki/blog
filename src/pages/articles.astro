---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts, plainText, tagInfo, tagOrder } from "../lib/posts";

const posts = await getPosts();

// タグ一覧（記事数つき）。tags.json の順 → 未定義のタグの順
const counts = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1)));
const tags = [...tagOrder.filter((t) => counts.has(t)), ...[...counts.keys()].filter((t) => !tagOrder.includes(t))];

// クライアント側の全文検索用
const index = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  text: plainText(p.body),
  tags: p.data.tags.map((t) => tagInfo(t).label).join(" "),
}));
const indexJson = JSON.stringify(index).replace(/</g, "\\u003c");
---
<Base title="all articles" current="articles">
  <section class="section">
    <h2 class="section-title">all articles <span class="count" id="result-count">({posts.length})</span></h2>

    <div class="toolbar">
      <label class="field field-search">
        <span class="field-label">search</span>
        <input type="search" id="q" placeholder="全文検索…" autocomplete="off">
      </label>
      <label class="field">
        <span class="field-label">sort</span>
        <select id="sort">
          <option value="new">newest</option>
          <option value="old">oldest</option>
          <option value="updated">recently updated</option>
          <option value="title">title</option>
        </select>
      </label>
      <label class="field">
        <span class="field-label">per page</span>
        <select id="per-page">
          <option value="6">6</option>
          <option value="9" selected>9</option>
          <option value="12">12</option>
          <option value="24">24</option>
          <option value="0">all</option>
        </select>
      </label>
    </div>

    <div class="tag-filter" id="tag-filter">
      {tags.map((t) => {
        const info = tagInfo(t);
        return (
          <button type="button" class="tag" style={`--tag:${info.color}`} data-tag={t} aria-pressed="false">
            {info.label} <span style="opacity:.6">{counts.get(t)}</span>
          </button>
        );
      })}
      <button type="button" class="clear" data-clear hidden>clear</button>
    </div>

    <div class="card-grid" id="article-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <p class="empty" id="empty" hidden>該当する記事はありません。</p>

    <nav class="pagination" id="pagination" aria-label="pagination"></nav>
  </section>

  <script type="application/json" id="search-index" set:html={indexJson}></script>
  <script src="../scripts/articles.ts"></script>
</Base>
