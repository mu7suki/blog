---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import TagList from "../components/TagList.astro";
import { formatDate, getPosts, letterCount, plainText, type Post } from "../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, date, updated, tags } = post.data;

const meta = [formatDate(date), `${letterCount(post.body)} letters`];
if (updated && updated !== date) meta.push(`update: ${formatDate(updated)}`);
---
<Base title={title} description={plainText(post.body).slice(0, 120)}>
  <article class="post">
    <p class="post-meta">
      {meta.map((m, i) => <>{i > 0 && <span class="slash">／</span>}{m}</>)}
    </p>
    <h1 class="post-title">{title}</h1>
    <TagList tags={tags} />
    <div class="post-body">
      <Content />
    </div>
  </article>
</Base>
